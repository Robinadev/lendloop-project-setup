# Copy to .env locally. Never commit the filled-in .env file.
# Use a long random value (at least 32 characters) for both secrets.
N8N_ENCRYPTION_KEY=replace-with-a-unique-64-character-random-value
LENDLOOP_SHARED_SECRET=replace-with-the-same-32-plus-character-secret-configured-in-Convex

# Public HTTPS origin reachable by Convex; include the trailing slash.
WEBHOOK_URL=https://your-public-n8n-host/
# Convex HTTP actions origin, without a trailing slash.
CONVEX_SITE_URL=https://your-deployment.convex.site
GENERIC_TIMEZONE=UTC

# Import error-handler.json first. The other workflows are linked to it by ID.
