{
  "name": "LendLoop - Error handler",
  "id": "cf9c5918-42ef-4f20-9b7d-d7e4f37a2bf3",
  "nodes": [
    {
      "parameters": {},
      "id": "err",
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        0,
        200
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const crypto = require('crypto');\nconst secret = $env.LENDLOOP_SHARED_SECRET;\nif (!secret || secret.length < 32) throw new Error('LENDLOOP_SHARED_SECRET must be set to at least 32 characters');\nconst ts = String(Date.now());\nconst sign = (body) => 'sha256=' + crypto.createHmac('sha256', secret).update(ts + '.' + body).digest('hex');\nconst e = $json;\nconst body = JSON.stringify({\n  executionId: String(e.execution?.id ?? ''),\n  workflow: e.workflow?.name ?? '',\n  node: e.execution?.lastNodeExecuted ?? '',\n  message: String(e.execution?.error?.message ?? '').slice(0, 500),\n});\nconsole.error('[LendLoop workflow failure]', body);\nreturn [{ json: { body, ts, sig: sign(body) } }];"
      },
      "id": "sign-error-report",
      "name": "Sign error report",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.CONVEX_SITE_URL }}/n8n/error",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-lendloop-timestamp",
              "value": "={{ $json.ts }}"
            },
            {
              "name": "x-lendloop-signature",
              "value": "={{ $json.sig }}"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "options": {
          "timeout": 15000
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ $json.body }}"
      },
      "id": "report-to-convex",
      "name": "Report to Convex",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        200
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    }
  ],
  "connections": {
    "Error Trigger": {
      "main": [
        [
          {
            "node": "Sign error report",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Sign error report": {
      "main": [
        [
          {
            "node": "Report to Convex",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "active": false
}
