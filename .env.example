# Clerk Next.js keys are provided by the connected Clerk development app.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Convex integration injects NEXT_PUBLIC_CONVEX_URL and deployment variables.
# The generated development Clerk issuer is pinned in convex/auth.config.ts.
# Replace that issuer with your production Frontend API URL when switching apps.

# Configure these in the Convex deployment and n8n instance with the same secret.
LENDLOOP_SHARED_SECRET=replace-with-a-long-random-secret
N8N_WEBHOOK_URL=https://your-n8n-host/webhook/lendloop-request
